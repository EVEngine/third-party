# ABI defaults shared by standalone binary releases and EVEngine source builds.
set(ASSIMP_BUILD_USE_CCACHE OFF CACHE BOOL "" FORCE)
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL" CACHE STRING "" FORCE)
if(WIN32 AND NOT CMAKE_SYSTEM_NAME STREQUAL "Android")
    set(CMAKE_DEBUG_POSTFIX mdd CACHE STRING "" FORCE)
    foreach(config RELEASE MINSIZEREL RELWITHDEBINFO)
        set(CMAKE_${config}_POSTFIX md CACHE STRING "" FORCE)
    endforeach()
endif()
if(NOT ANDROID AND NOT CMAKE_SYSTEM_NAME STREQUAL "iOS" AND NOT CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
    set(SDL_SHARED ON CACHE BOOL "" FORCE)
    set(SDL_STATIC ON CACHE BOOL "" FORCE)
    set(SDL_STATIC_PIC ON CACHE BOOL "" FORCE)
endif()
if(ANDROID AND ANDROID_ABI MATCHES "^x86(_64)?$")
    set(ALSOFT_CPUEXT_NEON OFF CACHE BOOL "" FORCE)
endif()

# Release packages fix the build profile, rather than inheriting host defaults.
if(EVENGINE_DEPS_RELEASE)
    set(EVENGINE_BUILD_JOLT ON CACHE BOOL "" FORCE)
    set(CMAKE_INSTALL_LIBDIR lib CACHE STRING "" FORCE)
    set(ALSOFT_UTILS OFF CACHE BOOL "" FORCE)
    set(ALSOFT_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(ALSOFT_INSTALL_EXAMPLES OFF CACHE BOOL "" FORCE)
    if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
        set(VIDEO_COCOA OFF CACHE BOOL "" FORCE)
        set(VIDEO_OPENGL OFF CACHE BOOL "" FORCE)
    endif()
endif()
