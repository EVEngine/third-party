function(eve_reference_math_verify_vendor root)
    file(READ "${root}/UPSTREAM.json" _ledger)
    string(JSON _schema GET "${_ledger}" schema)
    string(JSON _version GET "${_ledger}" version)
    if(NOT _schema STREQUAL "evengine.reference-math.vendor-provenance" OR NOT _version EQUAL 1)
        message(FATAL_ERROR "Unsupported reference-math provenance ledger")
    endif()
    string(JSON _count LENGTH "${_ledger}" dependencies)
    if(NOT _count EQUAL 2)
        message(FATAL_ERROR "Reference math requires its two canonical numerical providers")
    endif()
    set(_seen "")
    foreach(_index RANGE 0 1)
        string(JSON _name GET "${_ledger}" dependencies ${_index} name)
        if(NOT _name STREQUAL "v8" AND NOT _name STREQUAL "core-math")
            message(FATAL_ERROR "Unknown reference-math provider: ${_name}")
        endif()
        if(_name IN_LIST _seen)
            message(FATAL_ERROR "Duplicate reference-math provider: ${_name}")
        endif()
        list(APPEND _seen "${_name}")
        string(JSON _file_count LENGTH "${_ledger}" dependencies ${_index} files)
        if(_file_count LESS 1)
            message(FATAL_ERROR "Empty reference-math source snapshot")
        endif()
        math(EXPR _last "${_file_count} - 1")
        foreach(_file RANGE 0 ${_last})
            string(JSON _path GET "${_ledger}" dependencies ${_index} files ${_file} path)
            string(JSON _expected GET "${_ledger}" dependencies ${_index} files ${_file} sha256)
            file(SHA256 "${root}/vendor/${_name}/${_path}" _actual)
            if(NOT _actual STREQUAL _expected)
                message(FATAL_ERROR "Reference-math canonical source mismatch: ${_name}/${_path}")
            endif()
        endforeach()
    endforeach()
endfunction()
